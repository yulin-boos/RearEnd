# Relative paths are resolved from Visual, regardless of the working directory.
YOLO_MODEL_PATH=../model/best.pt
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=224
# A separate local CLIP model checks for plant leaves before disease inference.
LEAF_MODEL_PATH=../model/clip_leaf_gate
LEAF_DEVICE=cpu
LEAF_MIN_SIMILARITY=0.24
LEAF_MIN_MARGIN=0.02
DEFAULT_CONFIDENCE=0.5
DEFAULT_TOP_K=5
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
RESULT_DIR=storage/results
RESULT_TTL_SECONDS=86400
REQUIRE_NATIVE=false
HOST=127.0.0.1
PORT=8000
# DeepSeek key belongs only in the backend .env, never in the HTML page.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=1000
# Jev must approve both the question and the reply; there is no request-level bypass.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
JEV_MIN_RELEVANCE=0.8
JEV_MAX_VIOLATION=0.2
CHAT_DB_PATH=storage/chat.sqlite3
CHAT_SESSION_TTL_SECONDS=86400
CHAT_HISTORY_TURNS=10
CHAT_CONTEXT_TOP_K=5
# Login lifetime is 7 days; CHAT_DB_PATH is used only in SQLite test/migration mode.
AUTH_SESSION_TTL_SECONDS=604800
KNOWLEDGE_DB_PATH=storage/knowledge.sqlite3
KNOWLEDGE_MIN_VALUE=0.8
KNOWLEDGE_MIN_MATCH=0.85
KNOWLEDGE_TOP_K=3
KNOWLEDGE_CANDIDATE_LIMIT=6
KNOWLEDGE_DIRECT_ENABLED=true
KNOWLEDGE_DIRECT_MIN_MATCH=0.85
# Comma-separated frontend origins. Leave empty if CORS is unnecessary.
# "null" allows the local HTML test page to be opened directly.
CORS_ORIGINS=null,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Normal runtime uses the provisioned MySQL business database.
# SQLite paths above remain for offline regression tests and source migration.
DATABASE_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plant_health
DB_USER=plant_health_app
DB_PASSWORD=
DB_POOL_SIZE=6
DB_TIMEOUT_SECONDS=10
DB_SSL=true
# Optional CA file enables server certificate and hostname verification.
DB_SSL_CA=
